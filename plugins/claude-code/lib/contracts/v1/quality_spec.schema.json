{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adop.internal/contracts/v1/quality_spec.schema.json",
  "title": "Quality Rules Spec",
  "description": "Defines data quality rules across 5 dimensions with thresholds and anomaly detection.",
  "type": "object",
  "required": [
    "dataset_name",
    "schema_version",
    "rules",
    "quality_gates"
  ],
  "additionalProperties": false,
  "properties": {
    "dataset_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,40}$"
    },
    "schema_version": {
      "type": "string",
      "const": "v1"
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "completeness": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quality_rule"
          },
          "default": []
        },
        "uniqueness": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quality_rule"
          },
          "default": []
        },
        "validity": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quality_rule"
          },
          "default": []
        },
        "consistency": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quality_rule"
          },
          "default": []
        },
        "accuracy": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quality_rule"
          },
          "default": []
        }
      }
    },
    "quality_gates": {
      "type": "object",
      "required": [
        "bronze_to_silver",
        "silver_to_gold"
      ],
      "additionalProperties": false,
      "properties": {
        "bronze_to_silver": {
          "$ref": "#/$defs/gate_config"
        },
        "silver_to_gold": {
          "$ref": "#/$defs/gate_config"
        }
      }
    },
    "gate_before_publish": {
      "type": "boolean",
      "default": false,
      "description": "When true the gate itself publishes: quality_check reads the staging table given as TABLE_NAME and, only if the gate passes, writes it to PROMOTE_TO. Default false preserves the original order, in which the transform ran createOrReplace() and job.commit() before the gate started -- so the gate blocked the NEXT zone rather than its own publication, and quality_check_gold, being the last task, blocked nothing at all. Set alongside publish_via_gate on the matching silver_spec or gold_spec."
    },
    "anomaly_detection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "methods": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "z_score",
              "iqr",
              "volume_change",
              "null_spike",
              "distribution_shift"
            ]
          }
        },
        "volume_threshold_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 20
        }
      }
    },
    "compliance_rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "regulation": {
          "type": "string",
          "enum": [
            "HIPAA",
            "GDPR",
            "CCPA",
            "SOX",
            "PCI_DSS",
            "NONE"
          ]
        },
        "phi_columns": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "de_identification_standard": {
          "type": "string",
          "enum": ["safe_harbor", "expert_determination", "none_phi_with_controls", "not_assessed"],
          "default": "not_assessed",
          "description": "Which HIPAA de-identification standard the masked output is claimed to meet. Record it explicitly: masking is not the same as de-identification, and leaving this unstated is how a pipeline comes to be treated as de-identified because its columns are hashed. safe_harbor = 45 CFR 164.514(b)(2), all 18 identifiers removed, dates reduced to year, ages over 89 pooled, no re-identification code the covered entity can reverse. expert_determination = 164.514(b)(1), a documented statistician's determination of very small risk. none_phi_with_controls = the output IS still PHI and is protected by access control, encryption, audit logging and a BAA rather than by de-identification — the honest declaration for most masked-but-joinable analytics. not_assessed = nobody has decided, which should block a production grant.",
          "$comment": "HHS guidance treats a keyed or salted hash whose key the covered entity retains as a re-identification code, so hashed identifiers alone never reach safe_harbor."
        },
        "audit_retention_days": {
          "type": "integer",
          "minimum": 1
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quality_rule"
          }
        }
      }
    }
  },
  "$defs": {
    "quality_rule": {
      "type": "object",
      "required": [
        "rule_id",
        "column",
        "check_type",
        "threshold"
      ],
      "additionalProperties": false,
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "column": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "check_type": {
          "type": "string",
          "enum": [
            "not_null",
            "unique",
            "range",
            "regex",
            "enum",
            "referential",
            "custom_sql",
            "format",
            "length"
          ]
        },
        "threshold": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "severity": {
          "type": "string",
          "enum": [
            "critical",
            "warning",
            "info"
          ],
          "default": "warning"
        },
        "params": {
          "type": "object",
          "additionalProperties": true,
          "description": "Check-type-specific parameters (min/max for range, pattern for regex, etc.)"
        },
        "description": {
          "type": "string"
        },
        "zone": {
          "type": "string",
          "enum": [
            "silver",
            "gold",
            "both"
          ],
          "default": "both",
          "description": "Which zone this rule applies to. Defaults to both, which is the behaviour that existed before this field: every rule ran against every zone. That is why gold_quality crashed \u2014 the Silver rule set references claim-level columns the Gold fact does not have, so F.col() raised AnalysisException and the 0.95 gate could not even be scored (finding H4). Tag claim-level rules 'silver' and measure-level rules 'gold'."
        }
      }
    },
    "gate_config": {
      "type": "object",
      "required": [
        "overall_score",
        "action_on_failure"
      ],
      "additionalProperties": false,
      "properties": {
        "overall_score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "critical_failures": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Max allowed critical rule failures (0 = zero tolerance)"
        },
        "action_on_failure": {
          "type": "string",
          "enum": [
            "block",
            "quarantine",
            "warn"
          ]
        }
      }
    }
  }
}
