<#ProviderMapping> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery """SELECT * FROM claims_v2_db.Provider""" ] ;
    rr:subjectMap [
        rr:template "http://semantic.aws/claims/data/Provider/{provider_id}" ;
        rr:class ex:Provider
    ] ;
    rr:predicateObjectMap [
        rr:predicate ex:providerId ;
