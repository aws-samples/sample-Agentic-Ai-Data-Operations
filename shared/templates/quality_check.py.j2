{# template_version: 1.0.0 #}
{# required_slots: dataset_name, rules, quality_gates #}
{# schema_version: v1 #}
import sys
from datetime import datetime
from pathlib import Path

from pyspark.sql import functions as F
from awsglue.context import GlueContext
from awsglue.utils import getResolvedOptions
from pyspark.context import SparkContext

SCRIPT_DIR = Path(__file__).resolve().parent
PROJECT_ROOT = SCRIPT_DIR.parent.parent.parent
sys.path.insert(0, str(PROJECT_ROOT))

try:
    from shared.utils.structured_logger import StructuredLogger
except ModuleNotFoundError:  # pragma: no cover - exercised only on Glue
    # Glue executes this script standalone from S3, where the ADOP `shared` package is not
    # on sys.path -- the job would otherwise die at import before doing any work. This
    # fallback emits byte-identical JSON lines, so the artifact runs unmodified on Glue and
    # the observability contract still holds. If `shared` IS importable (a repo checkout, or
    # shipped via --extra-py-files), the real logger is used instead.
    import json as _json
    import sys as _sys
    from datetime import datetime as _dt, timezone as _tz

    class StructuredLogger:  # noqa: F811
        """Inline equivalent of shared.utils.structured_logger.StructuredLogger."""

        def __init__(self, agent, workload, run_id):
            self.context = {"agent": agent, "workload": workload, "run_id": run_id}

        def log(self, level, message, **extra):
            entry = {
                "timestamp": _dt.now(_tz.utc).isoformat(),
                "level": level,
                **self.context,
                "message": message,
                **extra,
            }
            print(_json.dumps(entry, default=str), file=_sys.stderr)

        def info(self, msg, **extra):
            self.log("INFO", msg, **extra)

        def warn(self, msg, **extra):
            self.log("WARN", msg, **extra)

        def error(self, msg, **extra):
            self.log("ERROR", msg, **extra)

        def debug(self, msg, **extra):
            self.log("DEBUG", msg, **extra)

        def phase_boundary(self, phase, status):
            self.log("PHASE", f"Phase {phase}: {status}", phase=phase, status=status)

        def artifact_created(self, path, checksum):
            self.log("ARTIFACT", f"Created {path}", path=path, checksum=checksum)

        def test_result(self, suite, passed, failed):
            self.log(
                "TEST",
                f"{suite}: {passed} passed, {failed} failed",
                suite=suite,
                passed=passed,
                failed=failed,
            )

logger = StructuredLogger(
    agent="quality_check",
    workload="{{ dataset_name }}",
    run_id="standalone",
)


def check_quality(spark, table_name, zone):
    logger.log("info", "quality_check_start", table=table_name, zone=zone)

    df = spark.table(table_name)
    total_rows = df.count()
    results = []

{% if rules.completeness is defined %}
    # Completeness checks
{% for rule in rules.completeness %}
    non_null_count = df.filter(F.col("{{ rule.column }}").isNotNull()).count()
    score = non_null_count / total_rows if total_rows > 0 else 0.0
    results.append({
        "rule_id": "{{ rule.rule_id }}",
        "dimension": "completeness",
        "column": "{{ rule.column }}",
        "score": score,
        "threshold": {{ rule.threshold }},
        "severity": "{{ rule.severity | default('warning') }}",
        "passed": score >= {{ rule.threshold }},
    })
{% endfor %}
{% endif %}

{% if rules.uniqueness is defined %}
    # Uniqueness checks
{% for rule in rules.uniqueness %}
    distinct_count = df.select("{{ rule.column }}").distinct().count()
    score = distinct_count / total_rows if total_rows > 0 else 0.0
    results.append({
        "rule_id": "{{ rule.rule_id }}",
        "dimension": "uniqueness",
        "column": "{{ rule.column }}",
        "score": score,
        "threshold": {{ rule.threshold }},
        "severity": "{{ rule.severity | default('warning') }}",
        "passed": score >= {{ rule.threshold }},
    })
{% endfor %}
{% endif %}

{% if rules.validity is defined %}
    # Validity checks
{% for rule in rules.validity %}
{% if rule.check_type == "range" %}
    valid_count = df.filter(
        (F.col("{{ rule.column }}") >= {{ rule.params.min }}) &
        (F.col("{{ rule.column }}") <= {{ rule.params.max }})
    ).count()
{% elif rule.check_type == "enum" %}
    valid_values = {{ rule.params["values"] | tojson }}
    valid_count = df.filter(F.col("{{ rule.column }}").isin(valid_values)).count()
{% elif rule.check_type == "regex" %}
    valid_count = df.filter(F.col("{{ rule.column }}").rlike("{{ rule.params.pattern }}")).count()
{% elif rule.check_type == "not_null" %}
    valid_count = df.filter(F.col("{{ rule.column }}").isNotNull()).count()
{% else %}
    valid_count = total_rows
{% endif %}
    score = valid_count / total_rows if total_rows > 0 else 0.0
    results.append({
        "rule_id": "{{ rule.rule_id }}",
        "dimension": "validity",
        "column": "{{ rule.column }}",
        "score": score,
        "threshold": {{ rule.threshold }},
        "severity": "{{ rule.severity | default('warning') }}",
        "passed": score >= {{ rule.threshold }},
    })
{% endfor %}
{% endif %}

    # Compute overall score
    if results:
        overall_score = sum(r["score"] for r in results) / len(results)
    else:
        overall_score = 1.0

    critical_failures = sum(
        1 for r in results
        if not r["passed"] and r["severity"] == "critical"
    )

    # Determine gate threshold
{% if quality_gates.bronze_to_silver is defined %}
    if zone == "silver":
        gate_threshold = {{ quality_gates.bronze_to_silver.overall_score }}
        max_critical = {{ quality_gates.bronze_to_silver.critical_failures | default(0) }}
{% endif %}
{% if quality_gates.silver_to_gold is defined %}
    if zone == "gold":
        gate_threshold = {{ quality_gates.silver_to_gold.overall_score }}
        max_critical = {{ quality_gates.silver_to_gold.critical_failures | default(0) }}
{% endif %}

    gate_passed = overall_score >= gate_threshold and critical_failures <= max_critical

    logger.log("info", "quality_check_complete",
        total_rows=total_rows, overall_score=overall_score,
        critical_failures=critical_failures, gate_passed=gate_passed,
        rules_checked=len(results))

    return {
        "workload": "{{ dataset_name }}",
        "table": table_name,
        "zone": zone,
        "total_rows": total_rows,
        "overall_score": overall_score,
        "critical_failures": critical_failures,
        "gate_passed": gate_passed,
        "results": results,
    }


if __name__ == "__main__":
    args = getResolvedOptions(sys.argv, ["JOB_NAME", "TABLE_NAME", "ZONE"])
    sc = SparkContext()
    glue_context = GlueContext(sc)
    spark = glue_context.spark_session
    result = check_quality(spark, args["TABLE_NAME"], args["ZONE"])
    if not result["gate_passed"]:
        raise RuntimeError(
            f"Quality gate FAILED: score={result['overall_score']:.3f}, "
            f"critical_failures={result['critical_failures']}"
        )
