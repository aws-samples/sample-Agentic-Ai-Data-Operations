{# template_id: quality_check #}
{# template_version: 1.1.0 #}
{# required_slots: dataset_name, rules, quality_gates #}
{# schema_version: v1 #}
{#
  One dispatch, used by both rules.validity and compliance_rules.rules.

  Deliberately a macro rather than a second copy of the if/elif chain. Two copies of one
  dispatch is how this template and its contract drifted apart: `compliance_rules` was
  never looped at all, and five of the contract's nine check types fell through a bare
  `{% else %}` that passed the row count through as the valid count — scoring 1.0 for a
  check that never ran. A check type added here now reaches every caller.

  `dimension` is passed in rather than inferred so a reader of the generated script can see
  which spec section a result came from.
#}
{% macro scored_rule(rule, dimension) -%}
{#
  One scoring path for every quality dimension.

  It used to serve only rules.validity and compliance_rules.rules. completeness and
  uniqueness emitted their own inline copies, which meant the runtime zone guard — the whole
  point of rule.zone — applied to two of the four loops. A completeness rule tagged
  zone: gold still constructed F.col() unconditionally and still raised AnalysisException
  against a Gold fact that lacks the column. Half a fix reads exactly like a whole one.

  The measurement differs by dimension; the scoring and the append do not:

    completeness  -> non-null count
    uniqueness    -> distinct count
    everything else -> the check_type dispatch below

  Variable names are per-dimension on purpose (non_null_count / distinct_count /
  valid_count) so folding the inline copies in here does not rewrite every existing
  artifact for no behavioural gain.
#}
{% set _zone = rule.zone | default("both") %}
{% set _body %}
{% if dimension == "completeness" %}
    non_null_count = df.filter(F.col("{{ rule.column }}").isNotNull()).count()
    score = non_null_count / total_rows if total_rows > 0 else 0.0
{% elif dimension == "uniqueness" %}
    distinct_count = df.select("{{ rule.column }}").distinct().count()
    score = distinct_count / total_rows if total_rows > 0 else 0.0
{% else %}
{% if rule.check_type == "range" %}
    valid_count = df.filter(
        (F.col("{{ rule.column }}") >= {{ rule.params.min }}) &
        (F.col("{{ rule.column }}") <= {{ rule.params.max }})
    ).count()
{% elif rule.check_type == "enum" %}
    valid_values = {{ rule.params["values"] | tojson }}
    valid_count = df.filter(F.col("{{ rule.column }}").isin(valid_values)).count()
{% elif rule.check_type == "regex" %}
    valid_count = df.filter(F.col("{{ rule.column }}").rlike("{{ rule.params.pattern }}")).count()
{% elif rule.check_type == "not_null" %}
    valid_count = df.filter(F.col("{{ rule.column }}").isNotNull()).count()
{% elif rule.check_type == "custom_sql" %}
{% if rule.params is not defined or rule.params.sql is not defined %}
{{ unsupported("quality rule '" ~ rule.rule_id ~ "' (" ~ dimension ~ ") is check_type "
   ~ "custom_sql but params.sql is not set, so there is no predicate to evaluate.") }}
{% endif %}
{#
  Out-of-band assertions must still refuse (finding L2).

  Implementing custom_sql un-refused these by accident: `lf_tags_present(member_dob)` became
  F.expr("lf_tags_present(member_dob)"), which Spark rejects as an undefined function at
  RUNTIME rather than at render time. That is strictly worse than refusing — a job that dies
  at 3am beats nothing, but a render that stops beats both.

  An explicit list, because whether an arbitrary SQL string calls a function Spark provides
  cannot be decided at render time. It is additive: add a name when a new pseudo-function
  shows up in a spec.
#}
{% set _out_of_band = ["lf_tags_present", "no_phi_literals_in_logs", "tbac_grant_exists",
                       "kms_key_rotated", "cloudtrail_event_present"] %}
{% for _fn in _out_of_band %}
{% if _fn in rule.params.sql %}
{{ unsupported("quality rule '" ~ rule.rule_id ~ "' (" ~ dimension ~ ") has params.sql "
   ~ "calling '" ~ _fn ~ "', which is not a Spark function — it is an assertion about Lake "
   ~ "Formation, KMS or CloudTrail, not a property of the dataframe. Rendering it would "
   ~ "produce F.expr() that fails at runtime as an undefined function, while the spec "
   ~ "records the rule as critical and blocking. Verify it out of band via MCP and record it "
   ~ "as severity info instead.") }}
{% endif %}
{% endfor %}
    # custom_sql: the predicate is a Spark SQL expression from the spec. Rows satisfying it
    # are the valid ones. This is what accuracy and consistency rules need — a comparison
    # across columns, or a condition, rather than a single-column check.
    valid_count = df.filter(F.expr({{ rule.params.sql | tojson }})).count()
{% else %}
{{ unsupported("quality rule '" ~ rule.rule_id ~ "' (" ~ dimension ~ ") uses check_type '"
   ~ rule.check_type ~ "', which this template has no branch for. Implemented: range, "
   ~ "enum, regex, not_null, custom_sql. This arm used to pass the row count straight "
   ~ "through as the valid count, scoring 1.0 — so a rule that never ran reported perfect "
   ~ "compliance, and because overall_score is an unweighted mean, adding an "
   ~ "unimplementable rule raised it. A compliance rule whose params are a pseudo-function "
   ~ "such as lf_tags_present(...) or no_phi_literals_in_logs(...) is not a property of the "
   ~ "dataframe at all: verify it out of band via MCP and record it as severity info, "
   ~ "rather than declaring an unexecutable check CRITICAL and blocking.") }}
{% endif %}
    score = valid_count / total_rows if total_rows > 0 else 0.0
{% endif %}
    results.append({
        "rule_id": "{{ rule.rule_id }}",
        "dimension": "{{ dimension }}",
        "column": "{{ rule.column }}",
        "score": score,
        "threshold": {{ rule.threshold }},
        "severity": "{{ rule.severity | default('warning') }}",
        "passed": score >= {{ rule.threshold }},
    })
{% endset %}
{% if _zone == "both" %}
{{ _body.strip("\n") }}
{% else %}
    if zone == "{{ _zone }}":
{{ _body.strip("\n") | indent(4, first=True) }}
{% endif %}
{%- endmacro %}
import sys
from datetime import datetime
from pathlib import Path

from pyspark.sql import functions as F
from awsglue.context import GlueContext
from awsglue.utils import getResolvedOptions
from pyspark.context import SparkContext

SCRIPT_DIR = Path(__file__).resolve().parent
PROJECT_ROOT = SCRIPT_DIR.parent.parent.parent
sys.path.insert(0, str(PROJECT_ROOT))

from shared.utils.structured_logger import StructuredLogger

logger = StructuredLogger(
    agent="quality_check",
    workload="{{ dataset_name }}",
    run_id="standalone",
)


def check_quality(spark, table_name, zone):
    logger.log("info", "quality_check_start", table=table_name, zone=zone)

    df = spark.table(table_name)
    total_rows = df.count()
    results = []

{% if rules.completeness is defined %}
    # Completeness checks
{% for rule in rules.completeness %}
{{ scored_rule(rule, "completeness") -}}
{% endfor %}
{% endif %}

{% if rules.uniqueness is defined %}
    # Uniqueness checks
{% for rule in rules.uniqueness %}
{{ scored_rule(rule, "uniqueness") -}}
{% endfor %}
{% endif %}

{% if rules.validity is defined %}
    # Validity checks
{% for rule in rules.validity %}
{{ scored_rule(rule, "validity") -}}
{% endfor %}
{% endif %}
{#
  accuracy and consistency. The contract has always allowed both, 06-quality-testing.md
  names all five dimensions as the standard, and neither was ever looped — so an accuracy
  rule like denied_claims_pay_zero and a consistency rule like
  amount_sanity_paid_lte_allowed_lte_billed were silently dropped. Same defect as
  compliance_rules, in its two remaining siblings; fixing one and not the others is how
  three of five came to look like five.

  Both naturally need check_type custom_sql — a comparison across columns, or a condition —
  which is why that branch was added to the macro in the same change.
#}
{% if rules.consistency is defined %}

    # Consistency checks
{% for rule in rules.consistency %}
{{ scored_rule(rule, "consistency") -}}
{% endfor %}
{% endif %}
{% if rules.accuracy is defined %}

    # Accuracy checks
{% for rule in rules.accuracy %}
{{ scored_rule(rule, "accuracy") -}}
{% endfor %}
{% endif %}
{% if compliance_rules is defined and compliance_rules.rules is defined %}

    # Compliance checks — {{ compliance_rules.regulation | default('NONE') }}
    #
    # These were never rendered before. The spec carried them, they validated, and
    # quality_check.py.j2 had no loop over compliance_rules.rules — so a rule the human
    # designated CRITICAL and blocking could not contribute to critical_failures below,
    # because that count only sees rules that were rendered. The masking gate attested a
    # control nothing executed.
    #
    # They score into `results` on the same footing as every other dimension, so a failing
    # compliance rule raises critical_failures and blocks the gate.
{% for rule in compliance_rules.rules %}
{{ scored_rule(rule, "compliance") -}}
{% endfor %}
{% endif %}

    # Compute overall score
    #
    # An empty result set used to score 1.0 and sail through the gate. That is the whole
    # defect this file keeps demonstrating: nothing to check is not the same as nothing
    # wrong. It matters more now that rules carry a `zone` — tag every rule "silver" and the
    # Gold gate would have had zero rules and passed with a perfect score, which is a worse
    # outcome than the AnalysisException it used to raise.
    if not results:
        raise RuntimeError(
            f"No quality rules applied to zone '{zone}' of {table_name}. A zone with no "
            f"rules cannot be scored, and reporting a pass for it would attest checks that "
            f"never ran. Tag rules for this zone in quality_spec (rules[].zone), or remove "
            f"the gate for it."
        )
    overall_score = sum(r["score"] for r in results) / len(results)

    critical_failures = sum(
        1 for r in results
        if not r["passed"] and r["severity"] == "critical"
    )

    # Determine gate threshold
{% if quality_gates.bronze_to_silver is defined %}
    if zone == "silver":
        gate_threshold = {{ quality_gates.bronze_to_silver.overall_score }}
        max_critical = {{ quality_gates.bronze_to_silver.critical_failures | default(0) }}
{% endif %}
{% if quality_gates.silver_to_gold is defined %}
    if zone == "gold":
        gate_threshold = {{ quality_gates.silver_to_gold.overall_score }}
        max_critical = {{ quality_gates.silver_to_gold.critical_failures | default(0) }}
{% endif %}

    gate_passed = overall_score >= gate_threshold and critical_failures <= max_critical

    logger.log("info", "quality_check_complete",
        total_rows=total_rows, overall_score=overall_score,
        critical_failures=critical_failures, gate_passed=gate_passed,
        rules_checked=len(results))

    return {
        "workload": "{{ dataset_name }}",
        "table": table_name,
        "zone": zone,
        "total_rows": total_rows,
        "overall_score": overall_score,
        "critical_failures": critical_failures,
        "gate_passed": gate_passed,
        "results": results,
    }


if __name__ == "__main__":
{#
  gate_before_publish. The gate publishes, so there is no code path that publishes without it.

  The DAG is transform_silver -> quality_check_silver -> aggregate_gold -> quality_check_gold,
  and each transform ran createOrReplace() followed by job.commit() before its gate started.
  So the gate blocked the NEXT zone, not its own publication: a failed Silver gate stopped Gold
  being built while unmasked PHI was already committed and queryable in Silver. And
  quality_check_gold is the last task in the graph, so it blocked nothing whatsoever -- it was
  an alarm wired to no circuit. CLAUDE.md's "Quality gates block promotion -- no bypassing"
  described a property the rendered pipeline did not have.

  PROMOTE_TO is resolved only in this branch. Glue's getResolvedOptions raises on a listed
  argument the caller did not supply, so listing it unconditionally would break every DAG that
  does not stage -- the same reason silver_transform resolves logical_date conditionally.
#}
{% if gate_before_publish | default(false) %}
    args = getResolvedOptions(sys.argv, ["JOB_NAME", "TABLE_NAME", "ZONE", "PROMOTE_TO"])
{% else %}
    args = getResolvedOptions(sys.argv, ["JOB_NAME", "TABLE_NAME", "ZONE"])
{% endif %}
    sc = SparkContext()
    glue_context = GlueContext(sc)
    spark = glue_context.spark_session
    result = check_quality(spark, args["TABLE_NAME"], args["ZONE"])
    if not result["gate_passed"]:
        raise RuntimeError(
            f"Quality gate FAILED: score={result['overall_score']:.3f}, "
            f"critical_failures={result['critical_failures']}"
        )
{% if gate_before_publish | default(false) %}

    # Publication. Reached only because the gate passed -- the raise above is the only other
    # exit, so nothing unapproved can be written here.
    _staging, _target = args["TABLE_NAME"], args["PROMOTE_TO"]
    if _staging == _target:
        # Otherwise the "promotion" rewrites the table onto itself: a no-op that logs success
        # while the transform has already published, which is the failure this whole branch
        # exists to remove. Louder to refuse than to appear to have gated.
        raise ValueError(
            f"PROMOTE_TO equals TABLE_NAME ({_target}). The gate would rewrite the staging "
            f"table onto itself and publication would still be happening in the transform. "
            f"Pass the staging table as TABLE_NAME and the real table as PROMOTE_TO."
        )
    spark.table(_staging).writeTo(_target).using("iceberg").createOrReplace()
    logger.log("info", "promoted_after_gate",
        staging=_staging, target=_target,
        overall_score=result["overall_score"], zone=result["zone"])
{% endif %}
