{
  "mcpServers": {
    "glue-athena": {
      "command": "uv",
      "args": ["run", "--no-project", "--with", "fastmcp", "--with", "boto3", "--python", "3.13", "mcp-servers/glue-athena-server/server.py"],
      "env": {
        "AWS_REGION": "us-east-1",
        "AWS_PROFILE": "adop-sandbox"
      }
    },
    "lakeformation": {
      "command": "uv",
      "args": ["run", "--no-project", "--with", "fastmcp", "--with", "boto3", "--python", "3.13", "mcp-servers/lakeformation-server/server.py"],
      "env": {
        "AWS_REGION": "us-east-1",
        "AWS_PROFILE": "adop-sandbox"
      }
    },
    "sagemaker-catalog": {
      "command": "uv",
      "args": ["run", "--no-project", "--with", "fastmcp", "--with", "boto3", "--python", "3.13", "mcp-servers/sagemaker-catalog-server/server.py"],
      "env": {
        "AWS_REGION": "us-east-1",
        "AWS_PROFILE": "adop-sandbox"
      }
    },
    "core": {
      "command": "uvx",
      "args": ["--from", "awslabs-aws-api-mcp-server", "awslabs.aws-api-mcp-server"],
      "env": {
        "AWS_REGION": "us-east-1",
        "AWS_PROFILE": "adop-sandbox",
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "iam": {
      "command": "uvx",
      "args": ["--from", "awslabs-iam-mcp-server", "awslabs.iam-mcp-server"],
      "env": {
        "AWS_REGION": "us-east-1",
        "AWS_PROFILE": "adop-sandbox",
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "lambda": {
      "command": "uvx",
      "args": ["--from", "awslabs-lambda-tool-mcp-server", "awslabs.lambda-tool-mcp-server"],
      "env": {
        "AWS_REGION": "us-east-1",
        "AWS_PROFILE": "adop-sandbox",
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "s3-tables": {
      "command": "uvx",
      "args": ["--from", "awslabs-s3-tables-mcp-server", "awslabs.s3-tables-mcp-server"],
      "env": {
        "AWS_REGION": "us-east-1",
        "AWS_PROFILE": "adop-sandbox",
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "cloudtrail": {
      "command": "uvx",
      "args": ["--from", "awslabs-cloudtrail-mcp-server", "awslabs.cloudtrail-mcp-server"],
      "env": {
        "AWS_REGION": "us-east-1",
        "AWS_PROFILE": "adop-sandbox",
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "redshift": {
      "command": "uvx",
      "args": ["--from", "awslabs-redshift-mcp-server", "awslabs.redshift-mcp-server"],
      "env": {
        "AWS_REGION": "us-east-1",
        "AWS_PROFILE": "adop-sandbox",
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "cloudwatch": {
      "command": "uvx",
      "args": ["--from", "awslabs-cloudwatch-mcp-server", "awslabs.cloudwatch-mcp-server"],
      "env": {
        "AWS_REGION": "us-east-1",
        "AWS_PROFILE": "adop-sandbox",
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "cost-explorer": {
      "command": "uvx",
      "args": ["--from", "awslabs-billing-cost-management-mcp-server", "awslabs.billing-cost-management-mcp-server"],
      "env": {
        "AWS_REGION": "us-east-1",
        "AWS_PROFILE": "adop-sandbox",
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "dynamodb": {
      "command": "uvx",
      "args": ["--from", "awslabs-dynamodb-mcp-server", "awslabs.dynamodb-mcp-server"],
      "env": {
        "AWS_REGION": "us-east-1",
        "AWS_PROFILE": "adop-sandbox",
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "pii-detection": {
      "command": "uv",
      "args": ["run", "--no-project", "--with", "fastmcp", "--with", "boto3", "--with", "mcp", "--python", "3.13", "mcp-servers/pii-detection-server/server.py"],
      "env": {
        "AWS_REGION": "us-east-1",
        "AWS_PROFILE": "adop-sandbox"
      }
    },
    "snowflake-native": {
      "type": "http",
      "url": "${SNOWFLAKE_MCP_URL}",
      "headers": {
        "Authorization": "Bearer ${SNOWFLAKE_MCP_TOKEN}"
      }
    },
    "databricks-native": {
      "type": "http",
      "url": "${DATABRICKS_MCP_URL}",
      "headers": {
        "Authorization": "Bearer ${DATABRICKS_MCP_TOKEN}"
      }
    },
    "teradata": {
      "command": "uvx",
      "args": ["teradata-mcp-server"],
      "env": {
        "DATABASE_URI": "${TERADATA_DATABASE_URI}"
      }
    }
  }
}
