{
  "mcpServers": {
    "glue-athena": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--with",
        "fastmcp",
        "--with",
        "boto3",
        "--python",
        "3.13",
        "mcp-servers/glue-athena-server/server.py"
      ]
    },
    "lakeformation": {
      "command": "uv",
      "args": [
        "run",
