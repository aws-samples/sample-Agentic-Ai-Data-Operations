{
  "name": "requirements-auditor",
  "description": "Deterministically reconciles explicit user requirements with workload evidence before phase promotion or deployment.",
  "prompt": "Read core/requirements-auditor.md in full. Use shared.requirements.auditor.audit_workload(). Read context.json, requirements.jsonl, decisions.jsonl, trace_events.jsonl, configs, generated artifacts, tests, and deployment evidence. Do not infer missing requirements. Do not call AWS, MCP, the network, or an LLM. Do not modify generated pipeline artifacts. Write only run/requirements_audit.json and append-only audit records under run/decisions.jsonl and logs/trace_events.jsonl; the permissions.rules block in this agent definition enforces this scope. Return success only when the audit report status is pass; missing, ambiguous, or conflicting mandatory evidence is blocking.",
  "tools": [
    "fs_read",
    "fs_write",
    "shell"
  ],
  "allowedTools": [
    "fs_read"
  ],
  "includeMcpJson": false,
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "match": [
          "**"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": [
          "workloads/*/run/requirements_audit.json",
          "workloads/*/run/decisions.jsonl",
          "workloads/*/logs/trace_events.jsonl"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": [
          "**"
        ],
        "exclude": [
          "workloads/*/run/requirements_audit.json",
          "workloads/*/run/decisions.jsonl",
          "workloads/*/logs/trace_events.jsonl"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "aws *",
          "curl *",
          "wget *",
          "ssh *",
          "scp *",
          "nc *",
          "rm *",
          "mv *",
          "chmod *",
          "git push *",
          "pip install *",
          "uv run *",
          "uvx *",
          "npm *"
        ],
        "effect": "deny"
      },
      {
        "capability": "mcp",
        "match": [
          "*"
        ],
        "effect": "deny"
      },
      {
        "capability": "subagent",
        "match": [
          "*"
        ],
        "effect": "deny"
      },
      {
        "capability": "web_fetch",
        "match": [
          "*"
        ],
        "effect": "deny"
      },
      {
        "capability": "web_search",
        "match": [
          "*"
        ],
        "effect": "deny"
      }
    ]
  },
  "resources": [
    "file://.kiro/steering/**/*.md",
    "file://core/requirements-auditor.md",
    "file://core/shared/requirements/auditor.py"
  ],
  "hooks": [
    {
      "name": "adop-cedar-gate",
      "trigger": "PreToolUse",
      "action": {
        "type": "command",
        "command": ".kiro/hooks/adop-hook.sh cedar_gate.py --principal requirements_auditor"
      }
    }
  ]
}
