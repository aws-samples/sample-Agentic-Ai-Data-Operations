{
  "name": "adop-local-plugins",
  "interface": {
    "displayName": "ADOP Local Plugins"
  },
  "plugins": [
    {
      "name": "adop-strands",
      "source": {
        "source": "local",
        "path": "./plugins/adop-strands"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Developer tools"
    },
    {
      "name": "adop",
      "source": {
        "source": "git-subdir",
        "url": "https://github.com/aws-samples/sample-Agentic-Ai-Data-Operations.git",
        "path": "./plugins/adop",
        "ref": "main"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Developer tools"
    }
  ]
}
