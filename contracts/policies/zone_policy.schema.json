{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adop.internal/contracts/policies/zone_policy.schema.json",
  "title": "ADOP Zone Governance Policy",
  "description": "Organization, domain, project, and per-run zone rules. Lower scopes may only tighten the organization baseline.",
  "type": "object",
  "required": ["contract_id", "version", "scope", "zones"],
  "additionalProperties": false,
  "properties": {
    "contract_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "scope": {
      "type": "string",
      "enum": ["organization", "domain", "project", "workload"]
    },
    "zones": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bronze": { "$ref": "#/$defs/zone" },
        "silver": { "$ref": "#/$defs/zone" },
        "gold": { "$ref": "#/$defs/zone" }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pii_detection_required": { "type": "boolean" },
        "encryption_at_rest": { "type": "string", "enum": ["kms"] },
        "encryption_in_transit": { "type": "string", "enum": ["tls"] }
      }
    }
  },
  "$defs": {
    "zone": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mutability": { "type": "string", "enum": ["immutable", "updatable"] },
        "required_format": { "type": "string", "enum": ["iceberg"] },
        "minimum_quality_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "allowed_source_formats": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["csv", "parquet", "json", "avro", "orc", "xml", "log"]
          }
        }
      }
    }
  }
}
